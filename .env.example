# Moogle Configuration
# Copy to .env and modify as needed

# --- Search parameters ---
# Maximum number of search results to return
SEARCH_TOP_K=10
# Minimum relevance score threshold (0~1); results below this are filtered out.
# 0.0 disables filtering (recommended): a non-zero default measurably cost recall
# without improving the top result. Raise it only if you want fewer, noisier-trimmed
# results -- see tests/eval_search.py --min-score.
SEARCH_MIN_SCORE=0.0

# --- LLM (DeepSeek, OpenAI-compatible API) ---
# Leave empty to use template replies (no external API call)
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Static file server port (video player page) ---
STATIC_PORT=8502
